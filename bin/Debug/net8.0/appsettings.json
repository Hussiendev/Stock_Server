{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=stockdb;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "SecretKey": "dev-only-secret-key-not-for-production",
